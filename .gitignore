node_modules
client/dist
# tsc must never leave compiled configs next to the .ts ones: Vite and Vitest prefer .js and would ignore edits to the .ts
client/vite.config.js
client/vite.config.d.ts
client/vitest.config.js
client/vitest.config.d.ts
server/dist
*.tsbuildinfo
analytics*.db
.env
coverage
playwright-report
.test-results
.vscode
.DS_Store

# Ignore CSV files by default
*.csv

# KEEP source files (needed for GitHub Actions)
!baseline-hitters-*.csv
!baseline-pitchers-*.csv
!player_id_map.csv

# Test fixtures are CSVs too
!tests/testthat/fixtures/*.csv

# ALLOW generated files in remote repo (GitHub Actions needs to commit these)
!full_stats_hitters.csv
!full_stats_pitchers.csv
!player_lookup.csv

# Keep other files
*.Rproj
*.png
!tjmcfarland.png
*.txt
*.html
*.jpg
*.numbers
