.DS_Store

# Ignore CSV files by default
*.csv

# KEEP source files (needed for GitHub Actions)
!data/baselines/baseline-hitters-*.csv
!data/baselines/baseline-pitchers-*.csv
!data/player_id_map.csv

# Test fixtures and goldens are CSVs too
!refresh/test/**/*.csv

# ALLOW generated files in remote repo (GitHub Actions needs to commit these)
!data/full_stats_hitters.csv
!data/full_stats_pitchers.csv
!data/player_lookup.csv

# Keep other files
*.png
!tjmcfarland.png
*.txt
*.html
*.jpg
*.numbers
